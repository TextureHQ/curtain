{
  "manifest_version": 3,
  "name": "Curtain",
  "description": "Masks PII in your app for safe demos, screenshots, and screen shares.",
  "version": "1.3.0",
  "permissions": ["storage", "activeTab"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'self' https://cdn.jsdelivr.net"
  },
  "host_permissions": [
    "https://*.texturehq.com/*",
    "https://localhost:*/*",
    "https://local.texturehq.com:*/*",
    "http://localhost:*/*",
    "file://*/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.texturehq.com/*",
        "https://localhost:*/*",
        "https://local.texturehq.com:*/*",
        "http://localhost:*/*",
        "file://*/*"
      ],
      "js": ["src/shared/data.js", "src/shared/pack-merge.js", "src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/shared/avatars/v1/*/*.webp", "src/shared/logos/*.png"],
      "matches": [
        "https://*.texturehq.com/*",
        "https://localhost:*/*",
        "https://local.texturehq.com:*/*",
        "http://localhost:*/*",
        "file://*/*"
      ]
    }
  ]
}
