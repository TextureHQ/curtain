{
  "name": "@texturehq/curtain-core",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TextureHQ/curtain.git",
    "directory": "packages/core"
  },
  "description": "Deterministic demo-data generation engine for the Curtain PII-masking extension and library users.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
