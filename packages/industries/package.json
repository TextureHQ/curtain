{
  "name": "@texturehq/curtain-industries",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TextureHQ/curtain.git",
    "directory": "packages/industries"
  },
  "description": "Public industry data packs (energy, healthcare, fintech) for @texturehq/curtain-core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./energy": {
      "types": "./dist/energy/index.d.ts",
      "import": "./dist/energy/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@texturehq/curtain-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
